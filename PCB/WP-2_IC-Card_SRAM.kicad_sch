	(text "All caps must be low profile 1.2mm height or less to fit under printed cover.\n\nCompatible with 128Kx8 to 512Kx8 SRAM.\n\nFor 128K SRAM: Bridge JP4 1-2. Omit SW1 D2 D3 R3 R4.\nFor 256K or 512K SRAM in 128K banks: Bridge JP2 1-2. Open JP2 2-3.\nFor 256K or 512K SRAM in 256K banks: Open JP2 1-2. Bridge JP2 2-3.\n\nFor normal RAM operation: Bridge JP3. Bridge JP1.\nTo emulate ROM: Open JP3. Open JP1.\n"
		(exclude_from_sim no)
		(at 162.306 168.402 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6cd63b89-b16c-4b9e-bf2b-df716ead463d")
	)
	(text "128K or 256K: join BUS-CE2\n512K: both open"
